# Use one line-ending policy to prevent cross-platform drift and override differing
# core.autocrlf settings across developer machines. See codex-rules/known-issues.md.

# Store text as LF by default and let Git detect text versus binary files.
* text=auto eol=lf

# Shell scripts and Git hooks must be checked out with LF. CRLF can cause
# `bad interpreter: /usr/bin/env bash^M` or leave a parser-breaking \r per line.
*.sh text eol=lf
.githooks/pre-commit text eol=lf
.githooks/commit-msg text eol=lf

# Python uses LF.
*.py text eol=lf

# PowerShell scripts use CRLF for Windows compatibility. Files must also retain
# their UTF-8 BOM for stable Windows PowerShell 5.1 decoding. The BOM is file
# content and Git does not add it; preserve it when editing .ps1 files.
*.ps1 text eol=crlf

# Never apply line-ending or encoding conversion to known binary formats.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
