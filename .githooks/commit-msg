#!/usr/bin/env bash
# Commit-message gate: require `<type>(<scope>): <English subject>` where type is
# feat|fix|docs|style|refactor|test|chore. Git invokes this zero-dependency hook
# with the commit-message file at $1. Enable once after cloning:
# git config core.hooksPath .githooks
set -euo pipefail
export LC_ALL=C

commit_msg_file="$1"

# Use the first non-empty, non-comment line as the subject.
subject_line=""
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    ""|"#"*) continue ;;
    *) subject_line="$line"; break ;;
  esac
done < "$commit_msg_file"

if [ -z "$subject_line" ]; then
  echo "commit-msg: the commit message is empty; commit blocked." >&2
  exit 1
fi

# Exempt Git-generated subjects: merges, reverts, reverts of reverts (Reapply),
# and the fixup!/squash!/amend! prefixes used by rebase --autosquash.
case "$subject_line" in
  "Merge "*|"Revert \""*|"Reapply \""*|"fixup! "*|"squash! "*|"amend! "*)
    exit 0
    ;;
esac

# Require a conventional type and non-empty scope. The subject must contain an
# ASCII letter so the default repository history remains English-readable.
pattern='^(feat|fix|docs|style|refactor|test|chore)\([A-Za-z0-9._/-]+\): [ -~]*[A-Za-z][ -~]*$'
if ! [[ "$subject_line" =~ $pattern ]]; then
  echo "commit-msg: invalid subject format; commit blocked." >&2
  echo "commit-msg: expected: <type>(<scope>): <English subject>" >&2
  echo "commit-msg: allowed types: feat|fix|docs|style|refactor|test|chore" >&2
  echo "commit-msg: example: feat(core): add stack recipe" >&2
  echo "commit-msg: received: $subject_line" >&2
  exit 1
fi

exit 0
