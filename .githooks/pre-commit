#!/usr/bin/env bash
# Local pre-commit gate: mirror CI by running the same `npm run quality` command.
# Enable once after cloning: git config core.hooksPath .githooks
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! command -v npm >/dev/null 2>&1; then
  echo "pre-commit: npm was not found; the quality gate cannot run, so the commit was blocked." >&2
  echo "pre-commit: install Node.js/npm (Node >= 22) and retry. Use git commit --no-verify only after assessing the risk." >&2
  exit 1
fi

echo "pre-commit: running npm run quality ..."
npm run quality
