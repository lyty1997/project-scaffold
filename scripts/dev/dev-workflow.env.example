# Remote host configuration for cross-machine previews. Copy this file to
# dev-workflow.env and adjust it for the current environment. The destination is
# ignored by Git. scripts/init.mjs normally generates it from your answers.
PREVIEW_HOST=__PREVIEW_HOST__
PREVIEW_PORT=__PREVIEW_PORT__
REMOTE_USER=__REMOTE_USER__
REMOTE_REPO_PATH=__REMOTE_REPO_PATH__
PREVIEW_SERVE_DIR=public
SSH_KEY_NAME=__SSH_KEY_NAME__
