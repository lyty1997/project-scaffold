{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Reusing the AI Coding Scaffold",
    "locale": "en",
    "quality_profile": "showcase",
    "legend": {
      "mode": "hidden"
    },
    "views": [
      {
        "id": "initialize",
        "label": "Turn the Template into a Project",
        "focus": ["obtain", "project-facts", "contracts"],
        "note": "Replace identity, stage, boundaries, and contracts before implementation."
      },
      {
        "id": "optional-preview",
        "label": "Configure Cross-Machine Preview",
        "focus": ["preview-decision", "preview-keep", "preview-remove", "stack-gates"],
        "note": "Optional capabilities must be explicitly retained and configured or fully removed."
      },
      {
        "id": "delivery-choice",
        "label": "Decide and Bootstrap CI/CD",
        "focus": ["cicd-decision", "cicd-build", "local-quality", "first-feature"],
        "note": "Generate and test CI/CD only after decisions are explicit; otherwise record a follow-up and continue locally."
      }
    ]
  },
  "lanes": [
    {
      "id": "initialization",
      "label": "Deterministic Initialization"
    },
    {
      "id": "choices",
      "label": "Project-Level Decisions"
    },
    {
      "id": "project",
      "label": "Project Implementation"
    },
    {
      "id": "deferred",
      "label": "Removal or Deferral",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "identity",
      "label": "Project Facts",
      "fromCol": 0,
      "toCol": 2
    },
    {
      "id": "options",
      "label": "Optional Capabilities",
      "fromCol": 3,
      "toCol": 4,
      "variant": "security"
    },
    {
      "id": "start-work",
      "label": "Establish an Executable Baseline",
      "fromCol": 5,
      "toCol": 5,
      "variant": "emphasis"
    }
  ],
  "mainPath": [
    "obtain",
    "project-facts",
    "contracts",
    "preview-decision",
    "preview-keep",
    "stack-gates",
    "cicd-decision",
    "cicd-build",
    "local-quality",
    "first-feature"
  ],
  "semanticChecks": {
    "allowedRoots": ["obtain"],
    "allowedTerminals": ["first-feature"],
    "requiredPaths": [
      {
        "from": "obtain",
        "to": "first-feature"
      }
    ]
  },
  "nodes": [
    {
      "id": "obtain",
      "lane": "initialization",
      "col": 0,
      "type": "external",
      "label": "Get Scaffold and Run init",
      "width": 200
    },
    {
      "id": "project-facts",
      "lane": "initialization",
      "col": 1,
      "type": "database",
      "label": "Set Identity and Rewrite Docs",
      "width": 200
    },
    {
      "id": "contracts",
      "lane": "initialization",
      "col": 2,
      "type": "database",
      "label": "Replace Contracts and Scan Rules",
      "width": 220
    },
    {
      "id": "preview-decision",
      "lane": "choices",
      "col": 3,
      "type": "security",
      "label": "Need Cross-Machine Preview?",
      "width": 220
    },
    {
      "id": "preview-keep",
      "lane": "project",
      "col": 3,
      "type": "backend",
      "label": "Keep and Configure Preview",
      "width": 210
    },
    {
      "id": "preview-remove",
      "lane": "deferred",
      "col": 3,
      "type": "external",
      "label": "Remove Unused Docs and Scripts",
      "width": 220
    },
    {
      "id": "stack-gates",
      "lane": "project",
      "col": 4,
      "type": "backend",
      "label": "Choose Stack and Add Real Gates",
      "width": 220
    },
    {
      "id": "cicd-decision",
      "lane": "choices",
      "col": 4,
      "type": "security",
      "label": "Release Path Defined?",
      "width": 220
    },
    {
      "id": "cicd-build",
      "lane": "project",
      "col": 5,
      "type": "cloud",
      "label": "Probe, Generate, and Test CI/CD",
      "width": 210
    },
    {
      "id": "local-quality",
      "lane": "initialization",
      "col": 5,
      "type": "security",
      "label": "Enable Hooks and Run Checks",
      "width": 210
    },
    {
      "id": "first-feature",
      "lane": "choices",
      "col": 5,
      "type": "backend",
      "label": "Start the First Real Feature",
      "width": 220
    }
  ],
  "edges": [
    {
      "id": "obtain-facts",
      "from": "obtain",
      "to": "project-facts",
      "role": "main"
    },
    {
      "id": "facts-contracts",
      "from": "project-facts",
      "to": "contracts",
      "label": "Project facts recorded",
      "role": "main"
    },
    {
      "id": "contracts-preview",
      "from": "contracts",
      "to": "preview-decision",
      "label": "Review optional capabilities",
      "role": "main"
    },
    {
      "id": "preview-keep-edge",
      "from": "preview-decision",
      "to": "preview-keep",
      "label": "Needed",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "preview-remove-edge",
      "from": "preview-decision",
      "to": "preview-remove",
      "label": "Not needed",
      "variant": "security",
      "role": "branch"
    },
    {
      "id": "keep-stack",
      "from": "preview-keep",
      "to": "stack-gates",
      "label": "Environment configured",
      "role": "main"
    },
    {
      "id": "remove-stack",
      "from": "preview-remove",
      "to": "stack-gates",
      "label": "Optional content removed",
      "role": "branch"
    },
    {
      "id": "stack-cicd",
      "from": "stack-gates",
      "to": "cicd-decision",
      "label": "Local baseline defined",
      "role": "main"
    },
    {
      "id": "cicd-build-edge",
      "from": "cicd-decision",
      "to": "cicd-build",
      "label": "Decision finalized",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "build-quality",
      "from": "cicd-build",
      "to": "local-quality",
      "label": "Remote workflow tested",
      "role": "main"
    },
    {
      "id": "cicd-defer-quality",
      "from": "cicd-decision",
      "to": "local-quality",
      "label": "Undecided: record follow-up",
      "variant": "security",
      "role": "branch"
    },
    {
      "id": "quality-feature",
      "from": "local-quality",
      "to": "first-feature",
      "label": "Baseline gates pass",
      "variant": "emphasis",
      "role": "main"
    }
  ]
}
