# System
.DS_Store
Thumbs.db

# Dependencies and package-manager caches
node_modules/
.npm/
.pnpm-store/
.venv/
venv/
__pycache__/
*.pyc

# Build outputs
dist/
build/
.next/
out/
coverage/

# Local environment
.env
.env.*
!.env.example
scripts/dev/dev-workflow.env
.claude/settings.local.json

# PlantUML is an external, checksum-pinned tool; local JAR copies are never committed.
plantuml.jar
plantuml-*.jar

# CI/CD probe output is an environment snapshot, not a decision record; keep it untracked.
# Decisions belong in docs/contracts/cicd-answers.json.
.cicd/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
