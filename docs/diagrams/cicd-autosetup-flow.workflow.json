{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Unidirectional CI/CD Setup Flow",
    "locale": "en",
    "quality_profile": "showcase",
    "legend": {
      "mode": "hidden"
    },
    "views": [
      {
        "id": "probe-decide",
        "label": "Probe and Decision Record",
        "focus": ["probe", "preflight", "answers"],
        "note": "Read local, remote, and permission facts first, then ask the user to decide project-level choices that cannot be detected."
      },
      {
        "id": "validation-fanout",
        "label": "Three-Way Validation Join",
        "focus": ["render", "quality-check", "actionlint", "draft-rehearsal", "green-gate"],
        "note": "Baseline gates, workflow semantics, and the remote rehearsal must all pass before the run is verified green."
      },
      {
        "id": "apply-close",
        "label": "Remote Apply and Closeout",
        "focus": ["green-gate", "remote-apply"],
        "note": "Only write remote configuration after a verified green run; then update the docs and create a local commit."
      }
    ]
  },
  "lanes": [
    {
      "id": "decision",
      "label": "Probe + Decisions"
    },
    {
      "id": "generation",
      "label": "Workflow Generation"
    },
    {
      "id": "baseline",
      "label": "Baseline Gates"
    },
    {
      "id": "semantics",
      "label": "Workflow Semantics"
    },
    {
      "id": "remote",
      "label": "Remote Rehearsal"
    },
    {
      "id": "blocked",
      "label": "Authorization Blocked",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "discover",
      "label": "Probe",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "decide-generate",
      "label": "Decide + Generate",
      "fromCol": 2,
      "toCol": 2,
      "variant": "emphasis"
    },
    {
      "id": "verify",
      "label": "Verify in Parallel",
      "fromCol": 3,
      "toCol": 4,
      "variant": "security"
    },
    {
      "id": "land",
      "label": "Apply",
      "fromCol": 5,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "probe",
    "preflight",
    "answers",
    "render",
    "quality-check",
    "green-gate",
    "remote-apply"
  ],
  "semanticChecks": {
    "allowedRoots": ["probe"],
    "allowedTerminals": ["authorization-stop", "remote-apply"],
    "requiredEdges": [
      {
        "from": "render",
        "to": "quality-check"
      },
      {
        "from": "render",
        "to": "actionlint"
      },
      {
        "from": "render",
        "to": "draft-rehearsal"
      }
    ],
    "requiredPaths": [
      {
        "from": "probe",
        "to": "remote-apply"
      },
      {
        "from": "render",
        "to": "green-gate"
      }
    ]
  },
  "nodes": [
    {
      "id": "probe",
      "lane": "decision",
      "col": 0,
      "type": "database",
      "label": "Read Repo and Access Signals",
      "width": 230
    },
    {
      "id": "preflight",
      "lane": "decision",
      "col": 1,
      "type": "security",
      "label": "Run Preflight",
      "width": 170
    },
    {
      "id": "authorization-stop",
      "lane": "blocked",
      "col": 2,
      "type": "external",
      "label": "Stop for Manual Authorization",
      "width": 200
    },
    {
      "id": "answers",
      "lane": "decision",
      "col": 2,
      "type": "database",
      "label": "Record Confirmed Decisions",
      "width": 220
    },
    {
      "id": "render",
      "lane": "generation",
      "col": 2,
      "type": "backend",
      "label": "Render Managed Workflow",
      "width": 210
    },
    {
      "id": "quality-check",
      "lane": "baseline",
      "col": 3,
      "type": "security",
      "label": "Run Zero-Dependency Gates",
      "width": 180
    },
    {
      "id": "actionlint",
      "lane": "semantics",
      "col": 3,
      "type": "security",
      "label": "Run actionlint",
      "width": 180
    },
    {
      "id": "draft-rehearsal",
      "lane": "remote",
      "col": 3,
      "type": "cloud",
      "label": "Run Draft PR Rehearsal",
      "width": 220
    },
    {
      "id": "green-gate",
      "lane": "decision",
      "col": 4,
      "type": "security",
      "label": "Verify Every Job and Step",
      "width": 210
    },
    {
      "id": "repair",
      "lane": "generation",
      "col": 3,
      "type": "backend",
      "label": "Fix Root Cause from Logs",
      "width": 210
    },
    {
      "id": "remote-apply",
      "lane": "remote",
      "col": 5,
      "type": "cloud",
      "label": "Apply, Document, Commit Locally",
      "width": 250
    }
  ],
  "edges": [
    {
      "id": "probe-preflight",
      "from": "probe",
      "to": "preflight",
      "label": "Facts",
      "role": "main"
    },
    {
      "id": "preflight-answers",
      "from": "preflight",
      "to": "answers",
      "label": "Access ready",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "preflight-stop",
      "from": "preflight",
      "to": "authorization-stop",
      "label": "Missing scope/admin",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "answers-render",
      "from": "answers",
      "to": "render",
      "label": "Decisions confirmed",
      "role": "main"
    },
    {
      "id": "render-quality",
      "from": "render",
      "to": "quality-check",
      "label": "Baseline checks",
      "role": "main"
    },
    {
      "id": "render-actionlint",
      "from": "render",
      "to": "actionlint",
      "label": "Semantic checks",
      "role": "async"
    },
    {
      "id": "render-rehearsal",
      "from": "render",
      "to": "draft-rehearsal",
      "label": "dry_run=true",
      "role": "async"
    },
    {
      "id": "quality-green",
      "from": "quality-check",
      "to": "green-gate",
      "label": "Pass",
      "role": "main"
    },
    {
      "id": "actionlint-green",
      "from": "actionlint",
      "to": "green-gate",
      "label": "Pass",
      "role": "return"
    },
    {
      "id": "rehearsal-green",
      "from": "draft-rehearsal",
      "to": "green-gate",
      "label": "Steps pass",
      "role": "return"
    },
    {
      "id": "green-repair",
      "from": "green-gate",
      "to": "repair",
      "label": "Any check fails",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "repair-render",
      "from": "repair",
      "to": "render",
      "label": "Regenerate and validate",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "green-apply",
      "from": "green-gate",
      "to": "remote-apply",
      "label": "Verified green",
      "variant": "emphasis",
      "role": "main"
    }
  ]
}
