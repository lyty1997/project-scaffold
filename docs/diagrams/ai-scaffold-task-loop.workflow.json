{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Minimal AI Coding Task Loop",
    "locale": "en",
    "quality_profile": "showcase",
    "legend": {
      "mode": "hidden"
    },
    "views": [
      {
        "id": "happy-path",
        "label": "Executable Task Path",
        "focus": ["receive", "load-context", "classify", "design-gate", "update-design", "implement", "validate", "progress", "report"],
        "note": "Follow task intake through design, implementation, verification, and delivery evidence."
      },
      {
        "id": "decision-stop",
        "label": "Pause for User Decisions",
        "focus": ["classify", "clarify", "wait-decision"],
        "note": "The Agent never fills in decisions that only the user can make."
      },
      {
        "id": "repair-loop",
        "label": "Root-Cause Repair Loop",
        "focus": ["implement", "validate"],
        "note": "Failed checks return to implementation for root-cause repair until they genuinely pass."
      }
    ]
  },
  "lanes": [
    {
      "id": "intake",
      "label": "Task Understanding"
    },
    {
      "id": "decision",
      "label": "Decision and Design"
    },
    {
      "id": "execution",
      "label": "Implementation and Verification"
    },
    {
      "id": "handoff",
      "label": "Evidence and Handoff"
    },
    {
      "id": "blocked",
      "label": "Awaiting User Decision",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "understand",
      "label": "Read the Facts",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "decide",
      "label": "Decision Gate",
      "fromCol": 2,
      "toCol": 3,
      "variant": "security"
    },
    {
      "id": "execute",
      "label": "Incremental Implementation and Acceptance",
      "fromCol": 4,
      "toCol": 5,
      "variant": "emphasis"
    }
  ],
  "mainPath": [
    "receive",
    "load-context",
    "classify",
    "design-gate",
    "update-design",
    "implement",
    "validate",
    "progress",
    "report"
  ],
  "semanticChecks": {
    "allowedRoots": ["receive"],
    "allowedTerminals": ["report", "wait-decision"],
    "requiredPaths": [
      {
        "from": "receive",
        "to": "report"
      },
      {
        "from": "validate",
        "to": "report"
      }
    ]
  },
  "nodes": [
    {
      "id": "receive",
      "lane": "intake",
      "col": 0,
      "type": "external",
      "label": "Receive Task",
      "width": 150
    },
    {
      "id": "load-context",
      "lane": "intake",
      "col": 1,
      "type": "database",
      "label": "Load Project Context",
      "width": 170
    },
    {
      "id": "classify",
      "lane": "decision",
      "col": 2,
      "type": "backend",
      "label": "Classify Information",
      "width": 180
    },
    {
      "id": "design-gate",
      "lane": "decision",
      "col": 3,
      "type": "security",
      "label": "Check Docs-First Scope",
      "width": 190
    },
    {
      "id": "update-design",
      "lane": "decision",
      "col": 4,
      "type": "database",
      "label": "Update Design or Contract",
      "width": 170
    },
    {
      "id": "implement",
      "lane": "execution",
      "col": 4,
      "type": "backend",
      "label": "Implement Incrementally",
      "width": 160
    },
    {
      "id": "validate",
      "lane": "execution",
      "col": 5,
      "type": "security",
      "label": "Run Risk-Appropriate Checks",
      "width": 210
    },
    {
      "id": "progress",
      "lane": "handoff",
      "col": 5,
      "type": "database",
      "label": "Update Progress",
      "width": 180
    },
    {
      "id": "report",
      "lane": "intake",
      "col": 5,
      "type": "external",
      "label": "Report Results",
      "width": 170
    },
    {
      "id": "clarify",
      "lane": "blocked",
      "col": 3,
      "type": "security",
      "label": "State Facts, Options, Impact",
      "width": 200
    },
    {
      "id": "wait-decision",
      "lane": "blocked",
      "col": 4,
      "type": "external",
      "label": "Pause Decision-Dependent Work",
      "width": 200
    }
  ],
  "edges": [
    {
      "id": "receive-context",
      "from": "receive",
      "to": "load-context",
      "role": "main"
    },
    {
      "id": "context-classify",
      "from": "load-context",
      "to": "classify",
      "label": "Verify and classify",
      "role": "main"
    },
    {
      "id": "classify-design",
      "from": "classify",
      "to": "design-gate",
      "label": "No decision blocker",
      "role": "main"
    },
    {
      "id": "classify-clarify",
      "from": "classify",
      "to": "clarify",
      "label": "Decision required",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "clarify-wait",
      "from": "clarify",
      "to": "wait-decision",
      "label": "Request user decision",
      "variant": "security",
      "role": "branch"
    },
    {
      "id": "design-update",
      "from": "design-gate",
      "to": "update-design",
      "label": "Docs-first change required",
      "variant": "security",
      "role": "main"
    },
    {
      "id": "design-implement",
      "from": "design-gate",
      "to": "implement",
      "label": "No design update needed",
      "role": "branch"
    },
    {
      "id": "update-implement",
      "from": "update-design",
      "to": "implement",
      "label": "Design synchronized",
      "role": "main"
    },
    {
      "id": "implement-validate",
      "from": "implement",
      "to": "validate",
      "label": "Submit this iteration",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "validate-repair",
      "from": "validate",
      "to": "implement",
      "label": "Failed: fix root cause",
      "variant": "security",
      "role": "error",
      "route": "bottom-channel"
    },
    {
      "id": "validate-progress",
      "from": "validate",
      "to": "progress",
      "label": "All checks pass",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "progress-report",
      "from": "progress",
      "to": "report",
      "label": "Delivery evidence",
      "role": "main"
    }
  ]
}
