{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "AI 编码脚手架复用流程",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "legend": {
      "mode": "hidden"
    },
    "views": [
      {
        "id": "initialize",
        "label": "把模板变成项目",
        "focus": ["obtain", "project-facts", "contracts"],
        "note": "先替换身份、阶段、边界和契约，再进入技术实现。"
      },
      {
        "id": "optional-preview",
        "label": "按需处理跨机预览",
        "focus": ["preview-decision", "preview-keep", "preview-remove", "stack-gates"],
        "note": "可选能力必须明确保留并配置，或完整移除。"
      },
      {
        "id": "delivery-choice",
        "label": "CI/CD 决策与起步",
        "focus": ["cicd-decision", "cicd-build", "local-quality", "first-feature"],
        "note": "决定已明确才生成并实测；否则记录待办后继续本地基线。"
      }
    ]
  },
  "lanes": [
    {
      "id": "initialization",
      "label": "机械初始化"
    },
    {
      "id": "choices",
      "label": "项目级取舍"
    },
    {
      "id": "project",
      "label": "项目工程落地"
    },
    {
      "id": "deferred",
      "label": "删除或延期分支",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "identity",
      "label": "项目事实",
      "fromCol": 0,
      "toCol": 2
    },
    {
      "id": "options",
      "label": "可选能力",
      "fromCol": 3,
      "toCol": 4,
      "variant": "security"
    },
    {
      "id": "start-work",
      "label": "形成可执行基线",
      "fromCol": 5,
      "toCol": 5,
      "variant": "emphasis"
    }
  ],
  "mainPath": [
    "obtain",
    "project-facts",
    "contracts",
    "preview-decision",
    "preview-keep",
    "stack-gates",
    "cicd-decision",
    "cicd-build",
    "local-quality",
    "first-feature"
  ],
  "semanticChecks": {
    "allowedRoots": ["obtain"],
    "allowedTerminals": ["first-feature"],
    "requiredPaths": [
      {
        "from": "obtain",
        "to": "first-feature"
      }
    ]
  },
  "nodes": [
    {
      "id": "obtain",
      "lane": "initialization",
      "col": 0,
      "type": "external",
      "label": "取得脚手架并运行 init",
      "width": 200
    },
    {
      "id": "project-facts",
      "lane": "initialization",
      "col": 1,
      "type": "database",
      "label": "填写身份并重写 docs",
      "width": 200
    },
    {
      "id": "contracts",
      "lane": "initialization",
      "col": 2,
      "type": "database",
      "label": "替换项目契约与扫描入口",
      "width": 220
    },
    {
      "id": "preview-decision",
      "lane": "choices",
      "col": 3,
      "type": "security",
      "label": "是否需要跨机协同预览",
      "width": 220
    },
    {
      "id": "preview-keep",
      "lane": "project",
      "col": 3,
      "type": "backend",
      "label": "保留并配置预览工作流",
      "width": 210
    },
    {
      "id": "preview-remove",
      "lane": "deferred",
      "col": 3,
      "type": "external",
      "label": "删除不用的可选文档与脚本",
      "width": 220
    },
    {
      "id": "stack-gates",
      "lane": "project",
      "col": 4,
      "type": "backend",
      "label": "确定技术栈并接入真实门禁",
      "width": 220
    },
    {
      "id": "cicd-decision",
      "lane": "choices",
      "col": 4,
      "type": "security",
      "label": "部署与发布决定是否明确",
      "width": 220
    },
    {
      "id": "cicd-build",
      "lane": "project",
      "col": 5,
      "type": "cloud",
      "label": "探测、生成并实测 CI/CD",
      "width": 210
    },
    {
      "id": "local-quality",
      "lane": "initialization",
      "col": 5,
      "type": "security",
      "label": "启用 hooks 并运行 quality",
      "width": 210
    },
    {
      "id": "first-feature",
      "lane": "choices",
      "col": 5,
      "type": "backend",
      "label": "从第一个真实功能开始迭代",
      "width": 220
    }
  ],
  "edges": [
    {
      "id": "obtain-facts",
      "from": "obtain",
      "to": "project-facts",
      "role": "main"
    },
    {
      "id": "facts-contracts",
      "from": "project-facts",
      "to": "contracts",
      "label": "项目事实已写入",
      "role": "main"
    },
    {
      "id": "contracts-preview",
      "from": "contracts",
      "to": "preview-decision",
      "label": "检查可选能力",
      "role": "main"
    },
    {
      "id": "preview-keep-edge",
      "from": "preview-decision",
      "to": "preview-keep",
      "label": "需要",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "preview-remove-edge",
      "from": "preview-decision",
      "to": "preview-remove",
      "label": "不需要",
      "variant": "security",
      "role": "branch"
    },
    {
      "id": "keep-stack",
      "from": "preview-keep",
      "to": "stack-gates",
      "label": "环境已配置",
      "role": "main"
    },
    {
      "id": "remove-stack",
      "from": "preview-remove",
      "to": "stack-gates",
      "label": "可选内容已移除",
      "role": "branch"
    },
    {
      "id": "stack-cicd",
      "from": "stack-gates",
      "to": "cicd-decision",
      "label": "本地工程基线已明确",
      "role": "main"
    },
    {
      "id": "cicd-build-edge",
      "from": "cicd-decision",
      "to": "cicd-build",
      "label": "决定已明确",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "build-quality",
      "from": "cicd-build",
      "to": "local-quality",
      "label": "远端链路已实测",
      "role": "main"
    },
    {
      "id": "cicd-defer-quality",
      "from": "cicd-decision",
      "to": "local-quality",
      "label": "未明确：记录待办",
      "variant": "security",
      "role": "branch"
    },
    {
      "id": "quality-feature",
      "from": "local-quality",
      "to": "first-feature",
      "label": "基础门禁通过",
      "variant": "emphasis",
      "role": "main"
    }
  ]
}
