root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell scripts use CRLF and retain the UTF-8 BOM (see codex-rules/known-issues.md).
[*.ps1]
end_of_line = crlf
